VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerodotemail"

# Change this to a random string, use `openssl rand -hex 32` to generate a 32 character string
BETTER_AUTH_SECRET=my-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

COOKIE_DOMAIN="localhost"

# Change to your project's client ID and secret, these work with localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstash/Local Redis Instance
REDIS_URL="http://localhost:8079"
REDIS_TOKEN="upstash-local-token"

# Resend API Key
RESEND_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys) — used for both chat and Perplexity-sonar calls
OPENROUTER_API_KEY=

# OpenRouter model slugs (e.g. openai/gpt-4o, anthropic/claude-3.7-sonnet)
OPENAI_MODEL=
OPENAI_MINI_MODEL=

#AI PROMPT
AI_SYSTEM_PROMPT=""

NODE_ENV="development"

# Cloudflare API token — only needed when running the server in Docker so wrangler
# can reach Vectorize + Workers AI without `wrangler login`. Create one at:
# https://dash.cloudflare.com/profile/api-tokens with Workers AI + Vectorize read/write.
# Leave blank if you don't need semantic search / Workers AI in the container.
CLOUDFLARE_API_TOKEN=

# How many threads per Gmail sync page (max 500 per Gmail API call)
THREAD_SYNC_MAX_COUNT=500
# When true, sync paginates through all threads. False = one page only.
THREAD_SYNC_LOOP=true
# Total cap across all pages per sync run. 0 = unlimited; set a number (e.g.
# 4000) to stop the loop once that many threads have synced so you don't
# exhaust the Gmail API quota on huge inboxes.
THREAD_SYNC_MAX_TOTAL=4000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Force Google OAuth to always show the consent screen so a refresh_token is issued.
FORCE_GOOGLE_AUTH=true

# FOR PLAYWRIGHT E2E TESTING
PLAYWRIGHT_SESSION_TOKEN =
PLAYWRIGHT_SESSION_DATA =
EMAIL =
